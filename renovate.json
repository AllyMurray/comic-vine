{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "timezone": "Europe/London",
  "schedule": ["* 0-5 * * *"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * *"],
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"],
    "schedule": [],
    "prConcurrentLimit": 0,
    "prCreation": "immediate",
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Automerge all minor and patch updates after successful CI.",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "constraintsFiltering": "strict"
    },
    {
      "description": "Prioritize transitive refreshes over ordinary version bumps.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "prPriority": 10
    },
    {
      "description": "Keep the TypeScript 6 compiler API for compatibility tooling and consumer checks.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@typescript/typescript6"],
      "allowedVersions": ">=6.0.0 <7.0.0"
    },
    {
      "description": "Keep the native compiler within the TS7.0 range supported by the installed declaration generator; review wider upgrades with rolldown-plugin-dts.",
      "matchManagers": ["npm"],
      "matchDepNames": ["@typescript/native"],
      "allowedVersions": ">=7.0.0 <7.1.0"
    },
    {
      "description": "Wait 24 hours before proposing ordinary npm updates, matching pnpm's release-age policy.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Packages maintained by the repository owner do not need the npm release-age delay; updates still require CI.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@http-client-toolkit/*"],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@eslint/**",
        "eslint",
        "eslint-*",
        "prettier",
        "globals",
        "typescript-eslint",
        "@typescript-eslint/**"
      ],
      "groupName": "lint and formatting tools"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["vitest", "@vitest/**", "vite", "nock"],
      "groupName": "test tooling"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "typescript",
        "tsdown",
        "tsx",
        "expect-type",
        "esbuild",
        "@typescript/typescript6"
      ],
      "groupName": "typescript and build tooling"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@types/**"],
      "groupName": "type definitions"
    },
    {
      "description": "Keep Node types aligned with the Node 24 LTS build/release runtime; update this bound deliberately when that runtime changes.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "allowedVersions": ">=24.0.0 <25.0.0"
    },
    {
      "description": "Update the HTTP client and its memory store together within the current major.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchPackageNames": [
        "@http-client-toolkit/core",
        "@http-client-toolkit/store-memory"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "http client toolkit",
      "groupSlug": "http-client-toolkit"
    },
    {
      "description": "Filter runtime and optional dependency updates against consumer Node support.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "optionalDependencies"],
      "constraintsFiltering": "strict"
    },
    {
      "description": "Preserve existing consumer support when proposing peer range extensions.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen",
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Node support is a deliberate library compatibility decision.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "Keep pre-1.0 updates ungrouped because they can break compatibility even in a patch; minor and patch updates still automerge after CI.",
      "matchManagers": ["npm"],
      "matchCurrentVersion": "<1.0.0",
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Never combine unrelated major upgrades, including inherited preset groups.",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "groupSlug": null,
      "automerge": false
    },
    {
      "description": "Keep size-limit and its exact-version peer plugin together, including coordinated major upgrades. The major rule above still disables automerge.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["size-limit", "@size-limit/file"],
      "groupName": "size limit",
      "groupSlug": "size-limit"
    },
    {
      "description": "Group GitHub Actions updates, keeping manually reviewed majors separate from automerging minor and patch updates. Keep this override after the general major rule.",
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-tags"],
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": true,
      "separateMinorPatch": false
    },
    {
      "description": "Vite+ and its Vite core alias must use the same release, including coordinated majors. Bundled Vitest is owned by Vite+; CI rejects mismatched versions.",
      "matchManagers": ["npm"],
      "matchFileNames": ["pnpm-workspace.yaml"],
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"],
      "groupName": "vite plus toolchain",
      "groupSlug": "vite-plus-toolchain",
      "separateMajorMinor": true,
      "separateMinorPatch": false,
      "rangeStrategy": "pin"
    }
  ]
}
