{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "timezone": "Europe/London",
  "schedule": ["* 0-5 * * *"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "rebaseWhen": "behind-base-branch",
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [],
    "prCreation": "immediate",
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null,
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Keep the TypeScript 6 compiler API for compatibility tooling and consumer checks.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@typescript/typescript6"],
      "allowedVersions": ">=6.0.0 <7.0.0",
      "automerge": false
    },
    {
      "description": "Keep the native compiler within the TS7.0 range supported by the installed declaration generator; review wider upgrades with rolldown-plugin-dts.",
      "matchManagers": ["npm"],
      "matchDepNames": ["@typescript/native"],
      "allowedVersions": ">=7.0.0 <7.1.0",
      "automerge": false
    },
    {
      "description": "Wait 24 hours before proposing ordinary npm updates, matching pnpm's release-age policy.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Keep patch and minor PRs separate only for stable development tools eligible for patch automerge.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchCurrentVersion": ">=1.0.0",
      "matchPackageNames": [
        "@eslint/**",
        "eslint",
        "eslint-*",
        "prettier",
        "globals",
        "typescript-eslint",
        "@typescript-eslint/**",
        "vitest",
        "@vitest/**",
        "vite",
        "nock",
        "@size-limit/**",
        "size-limit",
        "rimraf",
        "change-case",
        "pluralize"
      ],
      "separateMinorPatch": true
    },
    {
      "description": "Group and automerge stable patches to explicitly selected development tools only.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": ">=1.0.0",
      "matchPackageNames": [
        "@eslint/**",
        "eslint",
        "eslint-*",
        "prettier",
        "globals",
        "typescript-eslint",
        "@typescript-eslint/**",
        "vitest",
        "@vitest/**",
        "vite",
        "nock",
        "@size-limit/**",
        "size-limit",
        "rimraf",
        "change-case",
        "pluralize"
      ],
      "groupName": "development tooling patches",
      "constraintsFiltering": "strict",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "@eslint/**",
        "eslint",
        "eslint-*",
        "prettier",
        "globals",
        "typescript-eslint",
        "@typescript-eslint/**"
      ],
      "groupName": "lint and formatting tools"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["vitest", "@vitest/**", "vite", "nock"],
      "groupName": "test tooling"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "typescript",
        "tsdown",
        "tsx",
        "tsd",
        "esbuild",
        "@typescript/typescript6"
      ],
      "groupName": "typescript and build tooling"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@types/**"],
      "groupName": "type definitions"
    },
    {
      "description": "Keep Node types aligned with the Node 24 LTS build/release runtime; update this bound deliberately when that runtime changes.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "allowedVersions": ">=24.0.0 <25.0.0",
      "automerge": false
    },
    {
      "description": "Update the HTTP client and its memory store together within the current major; always review consumer-facing changes.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchPackageNames": [
        "@http-client-toolkit/core",
        "@http-client-toolkit/store-memory"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "http client toolkit",
      "groupSlug": "http-client-toolkit",
      "automerge": false
    },
    {
      "description": "Runtime and optional dependencies affect consumers and require review.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "optionalDependencies"],
      "constraintsFiltering": "strict",
      "automerge": false
    },
    {
      "description": "Preserve existing consumer support when proposing peer range extensions.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen",
      "groupName": null,
      "groupSlug": null,
      "automerge": false
    },
    {
      "description": "Node support is a deliberate library compatibility decision.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "Pre-1.0 releases can break compatibility even in a patch.",
      "matchManagers": ["npm"],
      "matchCurrentVersion": "<1.0.0",
      "groupName": null,
      "groupSlug": null,
      "automerge": false
    },
    {
      "description": "Never combine unrelated major upgrades, including inherited preset groups.",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "groupSlug": null,
      "automerge": false
    },
    {
      "description": "Keep size-limit and its exact-version peer plugin together, including coordinated major upgrades. The major rule above still disables automerge.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["size-limit", "@size-limit/file"],
      "groupName": "size limit",
      "groupSlug": "size-limit"
    },
    {
      "description": "Group all GitHub Actions updates, including majors, for one manually reviewed workflow update. Keep this override after the general major rule.",
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-tags"],
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "automerge": false
    },
    {
      "description": "Vite+ and its Vite core alias must use the same release, including coordinated majors. Bundled Vitest is owned by Vite+; CI rejects mismatched versions.",
      "matchManagers": ["npm"],
      "matchFileNames": ["pnpm-workspace.yaml"],
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"],
      "groupName": "vite plus toolchain",
      "groupSlug": "vite-plus-toolchain",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "rangeStrategy": "pin",
      "automerge": false
    }
  ]
}
